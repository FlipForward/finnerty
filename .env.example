# Copy to `.env.local` and fill in.
#
# Twitch channel name (lowercase login name, not the display name).
# Used by the future Twitch embed inside src/components/LiveOverlay.tsx.
# The Twitch `parent` parameter is derived from the browser hostname at runtime,
# so it does NOT belong here.
VITE_TWITCH_CHANNEL=mrfinnertytv
